---
import AuthNav from './react/AuthNav.tsx';
import MobileMenu from './react/MobileMenu.tsx';
import ThemeToggle from './react/ThemeToggle.tsx';
---
<header class="sticky top-0 z-40 border-b border-base-300 bg-base-100/80 backdrop-blur">
	<nav class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6" aria-label="Primary">
		<a href="/" class="flex shrink-0 items-center gap-2.5">
			<img src="/favicon.svg" alt="Bookshelf" width="30" height="30" class="h-8 w-8 rounded-xl" />
			<span class="font-display text-lg font-semibold tracking-tight text-base-content">
				Bookshelf
			</span>
		</a>

		<div class="flex shrink-0 items-center gap-1.5">
			<ThemeToggle client:load />
			<MobileMenu client:load />
			<AuthNav client:load />
		</div>
	</nav>
</header>