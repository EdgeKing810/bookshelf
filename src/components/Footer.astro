---
import ApiBadge from './react/ApiBadge.tsx';
---
<footer class="border-t border-base-300 bg-base-200/60">
	<div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
		<div class="grid gap-10 md:grid-cols-4">
			<div class="space-y-4 md:col-span-2">
				<a href="/" class="flex items-center gap-2.5">
					<img src="/favicon.svg" alt="Bookshelf" width="30" height="30" class="h-8 w-8 rounded-xl" />
					<span class="font-display text-lg font-semibold tracking-tight text-base-content">Bookshelf</span>
				</a>
				<p class="max-w-sm text-sm leading-relaxed opacity-70">
					Your cozy personal library — organize books into shelves, track your reading, and keep every
					story in one place.
				</p>
				<ApiBadge client:load />
			</div>

			<div>
				<h3 class="font-display text-sm font-semibold text-base-content">Library</h3>
				<ul class="mt-4 space-y-3 text-sm opacity-70">
					<li><a href="/library" class="transition hover:opacity-100">My shelves</a></li>
					<li><a href="/register" class="transition hover:opacity-100">Create an account</a></li>
					<li><a href="/login" class="transition hover:opacity-100">Sign in</a></li>
				</ul>
			</div>

			<div>
				<h3 class="font-display text-sm font-semibold text-base-content">Company</h3>
				<ul class="mt-4 space-y-3 text-sm opacity-70">
					<li><a href="/" class="transition hover:opacity-100">About</a></li>
					<li><a href="/account" class="transition hover:opacity-100">Account</a></li>
				</ul>
			</div>
		</div>

		<div class="mt-10 flex flex-col items-start justify-between gap-4 border-t border-base-300 pt-6 text-sm opacity-60 sm:flex-row sm:items-center">
			<p>© {new Date().getFullYear()} Bookshelf · Kinesis. All rights reserved.</p>
			<p class="flex items-center gap-1.5">
				Powered by
				<a href="https://api.kinesis.world" target="_blank" rel="noopener noreferrer" class="transition hover:opacity-80 mb-3">
					<img src="https://api.kinesis.world/static/banner.png" alt="Kinesis API" class="h-8 w-auto" />
				</a>
			</p>
		</div>
	</div>
</footer>