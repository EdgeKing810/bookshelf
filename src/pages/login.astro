---
import Layout from '../layouts/Layout.astro';
import LoginForm from '../components/react/LoginForm.tsx';
---
<Layout title="Sign in — Bookshelf" description="Sign in to your Bookshelf library.">
	<section class="mx-auto flex max-w-6xl px-4 py-16 sm:px-6">
		<div class="mx-auto w-full max-w-md">
			<div class="rounded-3xl border border-base-300 bg-base-100 p-8 shadow-sm">
				<a href="/" class="mb-8 flex items-center justify-center gap-2.5">
					<img src="/favicon.svg" alt="Bookshelf" width="30" height="30" class="h-8 w-8 rounded-xl" />
					<span class="font-display text-lg font-semibold tracking-tight text-base-content">Bookshelf</span>
				</a>

				<h1 class="text-center font-display text-2xl font-bold tracking-tight text-base-content">Welcome back</h1>
				<p class="mt-2 text-center text-sm opacity-70">Sign in to your account to continue.</p>

				<LoginForm client:load />

				<p class="mt-6 text-center text-sm opacity-70">
					New to Bookshelf?
					<a href="/register" class="btn btn-link btn-sm ml-2 px-0 text-primary hover:opacity-80">Create an account</a>
				</p>
			</div>
		</div>
	</section>
</Layout>