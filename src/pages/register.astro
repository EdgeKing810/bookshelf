---
import Layout from '../layouts/Layout.astro';
import RegisterForm from '../components/react/RegisterForm.tsx';
---
<Layout title="Create an account — Bookshelf" description="Start your personal library on Bookshelf.">
	<section class="mx-auto flex max-w-6xl px-4 py-16 sm:px-6">
		<div class="mx-auto w-full max-w-lg">
			<div class="rounded-3xl border border-base-300 bg-base-100 p-8 shadow-sm">
				<a href="/" class="mb-8 flex items-center justify-center gap-2.5">
					<img src="/favicon.svg" alt="Bookshelf" width="30" height="30" class="h-8 w-8 rounded-xl" />
					<span class="font-display text-lg font-semibold tracking-tight text-base-content">Bookshelf</span>
				</a>

				<h1 class="text-center font-display text-2xl font-bold tracking-tight text-base-content">Create your account</h1>
				<p class="mt-2 text-center text-sm opacity-70">Start your personal library in seconds.</p>

				<RegisterForm client:load />

				<p class="mt-6 text-center text-sm opacity-70">
					Already have an account?
					<a href="/login" class="btn btn-link btn-sm ml-2 px-0 text-primary hover:opacity-80">Sign in</a>
				</p>
			</div>
		</div>
	</section>
</Layout>