---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page not found — Bookshelf" description="This page could not be found.">
	<section class="mx-auto flex max-w-6xl px-4 py-24 text-center sm:px-6">
		<div class="mx-auto w-full max-w-md">
			<p class="font-display text-6xl font-bold text-primary">404</p>
			<h1 class="mt-4 font-display text-2xl font-bold tracking-tight text-base-content">This page is missing</h1>
			<p class="mt-2 text-sm opacity-70">
				Like a book borrowed and never returned, this page can't be found.
			</p>
			<div class="mt-8 flex flex-wrap items-center justify-center gap-3">
				<a href="/" class="btn btn-primary">Back to home</a>
				<a href="/library" class="btn btn-outline">My library</a>
			</div>
		</div>
	</section>
</Layout>