---
import Layout from '../layouts/Layout.astro';
import AccountPanel from '../components/react/AccountPanel.tsx';
---
<Layout title="Your account — Bookshelf" description="View and edit your Bookshelf profile.">
	<Fragment slot="head">
		<script is:inline>
			// The account page requires a session (JWT stored in localStorage by
			// AppContext). Redirect to sign in before the page renders otherwise.
			try {
				if (!localStorage.getItem('bookshelf.auth')) {
					window.location.replace('/login?next=/account');
				}
			} catch (e) {
				/* ignore */
			}
		</script>
	</Fragment>
	<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
		<AccountPanel client:load />
	</section>
</Layout>