---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Bookshelf — a cozy home for your book collection',
	description = 'Bookshelf is your personal library. Organize books into shelves, track your reading, and keep every story in one cozy place.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta name="theme-color" content="#1c1e24" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Lora:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<script is:inline>
			// Apply the saved theme before first paint to avoid a flash.
			(function () {
				try {
					var themes = ['bookshelf-light', 'bookshelf-dark', 'bookshelf-sepia'];
					var saved = localStorage.getItem('bookshelf.theme');
					var theme = themes.indexOf(saved) !== -1 ? saved : 'bookshelf-dark';
					document.documentElement.setAttribute('data-theme', theme);
				} catch (e) {
					document.documentElement.setAttribute('data-theme', 'bookshelf-dark');
				}
			})();
		</script>
		<slot name="head" />
		<title>{title}</title>
	</head>
	<body class="flex min-h-screen flex-col">
		<Header />
		<main class="flex-1">
			<slot />
		</main>
		<Footer />
	</body>
</html>